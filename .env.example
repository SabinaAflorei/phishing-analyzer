# Copiaza in .env si completeaza. .env NU intra in git.
# ATENTIE: nu conecta la mailbox-ul real inainte de discutia cu mentorul.

TRIAGE_IMAP_HOST=""
TRIAGE_IMAP_PORT=993
TRIAGE_IMAP_USER=""
TRIAGE_IMAP_APP_PASSWORD=""
TRIAGE_IMAP_FOLDER="INBOX"

# Sursa de date: "corpus" (implicit, offline) sau "imap"
TRIAGE_SOURCE="corpus"

TRIAGE_DB_PATH="data/db/triage.sqlite3"
TRIAGE_RAW_EML_DIR="data/raw_eml"

TRIAGE_OLLAMA_URL="http://127.0.0.1:11434"
# Punct de pornire, NU o decizie. Vezi README, sectiunea de decizii.
TRIAGE_OLLAMA_MODEL="llama3.1:8b"

# Modulul de imbogatire externa - implicit OPRIT (offline-first)
TRIAGE_ENRICHMENT_ENABLED="false"

TRIAGE_HOST="127.0.0.1"
TRIAGE_PORT=8000
