# (sectiunea 10). Pana atunci lasa TRIAGE_IMAP_HOST gol si tine
# `source: corpus` in config/settings.yaml.
#
# AICI STAU DOAR SECRETELE. Restul configurarii (sursa, cai, LLM, dashboard,
